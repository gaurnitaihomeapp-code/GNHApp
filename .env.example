# ==============================================================================
# GNH Prasadam & Expense Management App - Environment Variables Template
# ==============================================================================

# Mode: 'local' (isolated browser storage) or 'production' (Supabase cloud)
VITE_DATA_ENV=local

# Supabase Cloud Project Configuration (Required in Production)
# Leave empty in local development to operate in isolated local data mode
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Safety Override (Default: false)
# When set to true, allows connecting to production Supabase from local development (Use with caution!)
# VITE_ALLOW_PROD_IN_DEV=false
